<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     MainPage.xaml —— "主界面"页

     从上到下三块：
       ① 标题（股票小助手.v1）
       ② 搜索行：输入框(SearchBox) + 搜索按钮 → 输入代码如 sz159248 / sh510300
       ③ 行情区（简易表格版，以后会重新排版）：
          报价行：名称 + 代码 + 现价(大字) + 涨跌额 + 涨跌幅（红涨绿跌）
          指标行：今开/昨收/最高/最低/成交量/成交额/换手率
          盘口区：左"卖盘"五档 + 右"买盘"五档（价量）
     所有数值 TextBlock 都取了 x:Name，数据来了由代码(MainPage.xaml.cs)逐个填。
     ═══════════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="炒股小助手.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FF111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ① 标题（独占第一行） -->
            <RowDefinition Height="Auto"/>   <!-- ② 搜索行（第二行） -->
            <RowDefinition Height="*"/>      <!-- ③ 行情区（占剩余全部） -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ ① 标题（第一行，重新亮出来） ═══════════════ -->
        <!-- 之前版本它和搜索行叠在同一个 Grid 行里被盖住，现在独占一行 -->
        <TextBlock Grid.Row="0" Text="股票小助手.v0.9  先导测试版"
                   FontSize="30" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,36,0,0"/>

        <!-- ═══════════════ ② 搜索行 ═══════════════ -->
        <!-- 结构：市场按钮 + 输入框 + 搜索按钮；市场按钮底下挂一个 Popup 下拉列表 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,18,0,0">

            <!-- 市场按钮：x:Name = MarketBtn。没选过市场时显示"市场"，
                 选过后显示"沪市 / 深市 / 美股"。点击弹出 MarketPopup 下拉 -->
            <Button x:Name="MarketBtn"
                    Content="市场"
                    Style="{StaticResource SearchBtn}" Width="Auto" Padding="14,0"
                    Click="MarketBtn_Click"/>

            <!-- 输入框：现在按主人的设计，只填"纯数字代码"（如 159248），
                 带 sh/sz/us 前缀的完整代码由程序按所选市场自动拼 -->
            <TextBox x:Name="SearchBox"
                     Width="260" Height="34" FontSize="15"
                     VerticalContentAlignment="Center"
                     Margin="10,0,0,0"/>
            <!-- 搜索按钮：点击触发 Search_Click —— 它最优先检查 MarketMode，
                 没选市场就弹"请先选择市场"，选了才拼前缀、过冷却限制器再去查。
                 x:Name = SearchButton：冷却倒计时时要把它的字改成数字 -->
            <Button x:Name="SearchButton"
                    Content="搜索"
                    Style="{StaticResource SearchBtn}"
                    Margin="10,0,0,0"
                    Click="Search_Click"/>

            <!-- 市场下拉列表：一个浮动层（Popup），平时隐藏；
                 点"市场"按钮弹出，点选项后自动收起。
                 PlacementTarget 让它对准市场按钮，Placement=Bottom 让它出现在按钮正下方 -->
            <Popup x:Name="MarketPopup"
                   PlacementTarget="{Binding ElementName=MarketBtn}"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <!-- 列表本体：深色圆角框，竖排三个选项 -->
                <Border Background="#FF1C1C1C" BorderBrush="#FF3A3A3A"
                        BorderThickness="1" CornerRadius="3" MinWidth="90">
                    <StackPanel Margin="4">
                        <Button Content="沪市" Style="{StaticResource SearchBtn}" Width="Auto" Padding="14,0"
                                Click="MktShanghai_Click"/>
                        <Button Content="深市" Style="{StaticResource SearchBtn}" Width="Auto" Padding="14,0"
                                Margin="0,4,0,0" Click="MktShenzhen_Click"/>
                        <Button Content="美股" Style="{StaticResource SearchBtn}" Width="Auto" Padding="14,0"
                                Margin="0,4,0,0" Click="MktUS_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- ═══════════════ ③ 行情区（简易表） ═══════════════ -->
        <!-- ScrollViewer：窗口太矮时能上下滚动，不至于把内容挤没 -->
        <ScrollViewer Grid.Row="2" Margin="28,14,28,10"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── 报价行：名称 代码 现价 涨跌额 涨跌幅 ── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="qName" Text="—" FontSize="26" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="qCode" Text="" FontSize="14" Foreground="#FF9A9A9A"
                               Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="qPrice" Text="--" FontSize="26" FontFamily="Consolas"
                               Foreground="#FF9A9A9A" Margin="28,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="qChange" Text="--" FontSize="15" FontFamily="Consolas"
                               Foreground="#FF9A9A9A" Margin="14,0,0,4" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="qChangePct" Text="--" FontSize="15" FontFamily="Consolas"
                               Foreground="#FF9A9A9A" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
                </StackPanel>
                <!-- 注：现价/涨跌额/涨跌幅的颜色由代码控制：涨=红、跌=绿（A股习惯） -->

                <!-- ── 指标行：一行 7 个小格（标签在上 数值在下） ── -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 每个小格是同一套结构：Border 画框 → 里面"标签 + 数值" -->
                    <Border Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="今开" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qOpen" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="昨收" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qPreClose" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="最高" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qHigh" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="最低" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qLow" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="成交量" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qVol" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="成交额" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qAmt" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="换手率" FontSize="11" Foreground="#FF8A8A8A"/>
                            <TextBlock x:Name="qTurnover" Text="--" FontFamily="Consolas" FontSize="13"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 盘口区：左卖盘 右买盘，各 5 档 ── -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 卖盘（五档）：每档单独一行小 Grid（46px 档位名 + 数值右对齐） -->
                    <Border Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="卖盘（五档）" FontSize="12" Foreground="#FF8A8A8A"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卖五" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="s5" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF66BB6A" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卖四" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="s4" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF66BB6A" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卖三" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="s3" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF66BB6A" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卖二" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="s2" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF66BB6A" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卖一" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="s1" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FF66BB6A" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 买盘（五档） -->
                    <Border Grid.Column="1" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                            BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="买盘（五档）" FontSize="12" Foreground="#FF8A8A8A"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="买一" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="b1" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFE57373" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="买二" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="b2" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFE57373" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="买三" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="b3" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFE57373" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="买四" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="b4" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFE57373" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="买五" FontSize="13" Foreground="#FF8A8A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="b5" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                           Foreground="#FFE57373" HorizontalAlignment="Right" Text="--"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 东财缓存数据区（临时展示用，以后统一排版） ── -->
                <Border Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                        BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="东方财富缓存数据" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左：历史每日收盘（列表数据由代码刷新） -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock x:Name="eastDaily" Text="历史收盘：0 条" FontSize="12" Foreground="#FF8A8A8A"/>
                                <ListBox x:Name="listHistory" Height="150" Margin="0,4,0,0"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="#FF111111" Foreground="White"
                                         BorderBrush="#FF2A2A2A" BorderThickness="1"/>
                            </StackPanel>
                            <!-- 右：当日每分钟价格 -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock x:Name="eastMinute" Text="当日分时：0 条" FontSize="12" Foreground="#FF8A8A8A"/>
                                <ListBox x:Name="listMinute" Height="150" Margin="0,4,0,0"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="#FF111111" Foreground="White"
                                         BorderBrush="#FF2A2A2A" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
