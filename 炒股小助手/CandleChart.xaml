<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     CandleChart.xaml —— K 线图控件（可复用的一个小零件）

     这个控件本身不含标题/说明文字，就是"一块被框住的图"，高度由外面（主界面）给。
     里面叠了三层（Grid 里后写的盖在先写的上面）：
       ① KLineCanvas    静态层：坐标轴、网格、价格/日期刻度、蜡烛（只在缩放/改尺寸时重画）
       ② OverlayCanvas  交互层：十字线 + 鼠标所在那一列的高亮带（鼠标一动就重画）
       ③ TipBubble      悬停气泡：在某根 K 柱上停留 1 秒后弹出（开盘/收盘/最高/最低）

     ② ③ 都设了 IsHitTestVisible="False"：它们只是"画上去的"，不参与鼠标事件，
     所有鼠标事件统一由最底下的 KLineCanvas 接收。
     ═══════════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="炒股小助手.CandleChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 外框：把整张 K 线图完全框住（ClipToBounds 让内容不会溢出框外） -->
    <Border Background="#FF151515"
            BorderBrush="#FF3A3A3A" BorderThickness="1"
            CornerRadius="6" ClipToBounds="True">
        <Grid>
            <Canvas x:Name="KLineCanvas" Background="Transparent"
                    SizeChanged="KLineCanvas_SizeChanged"
                    MouseMove="KLineCanvas_MouseMove"
                    MouseLeave="KLineCanvas_MouseLeave"
                    MouseWheel="KLineCanvas_MouseWheel"/>

            <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False"/>

            <!-- 悬停气泡：四行数据，位置由代码按鼠标坐标算（默认在鼠标右上方） -->
            <Border x:Name="TipBubble" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Background="#F2191919" BorderBrush="#FF5A5A5A"
                    BorderThickness="1" CornerRadius="4" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开盘价"
                               FontSize="12" Foreground="#FF9A9A9A"/>
                    <TextBlock x:Name="TipOpen" Grid.Row="0" Grid.Column="1"
                               FontSize="12" Foreground="White" FontFamily="Consolas"
                               HorizontalAlignment="Right" Margin="18,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="收盘价"
                               FontSize="12" Foreground="#FF9A9A9A" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TipClose" Grid.Row="1" Grid.Column="1"
                               FontSize="12" Foreground="White" FontFamily="Consolas"
                               HorizontalAlignment="Right" Margin="18,3,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="最高价"
                               FontSize="12" Foreground="#FF9A9A9A" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TipHigh" Grid.Row="2" Grid.Column="1"
                               FontSize="12" Foreground="White" FontFamily="Consolas"
                               HorizontalAlignment="Right" Margin="18,3,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="最低价"
                               FontSize="12" Foreground="#FF9A9A9A" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TipLow" Grid.Row="3" Grid.Column="1"
                               FontSize="12" Foreground="White" FontFamily="Consolas"
                               HorizontalAlignment="Right" Margin="18,3,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
