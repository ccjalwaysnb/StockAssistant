<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     App.xaml —— 整个程序的"起点"和"公共资源仓库"

     1. StartupUri="MainWindow.xaml"：告诉 WPF，程序一启动就先打开主窗口
     2. <Application.Resources>：全程序共享的资源都放这里。
        任何窗口/页面里用 {StaticResource xxx} 找样式时，自己身上找不到，
        就会一级一级往上找，最后兜底到这一层。
        → 所以"全局通用的样式"放 App.xaml 最合适，每个页面都能直接用。
     ═══════════════════════════════════════════════════════════════════════════ -->
<Application x:Class="炒股小助手.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ─────────────── 深色按钮的"通用皮肤"（其它按钮样式都从它继承） ───────────────
             系统默认按钮是浅色系的，直接放黑底上会很刺眼，所以自己重新画一个：
             Template（模板）= 按钮的"皮肤"，决定按钮由哪些零件拼成、长什么样      -->
        <Style x:Key="BtnDark" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>            <!-- 文字：白色 -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>                 <!-- 鼠标移上去变成小手 -->
            <Setter Property="Background" Value="#FF262626"/>        <!-- 常态背景：深灰 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 按钮 = 一个圆角边框(bd)，中间放文字(Content) -->
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FF3A3A3A"
                                BorderThickness="1"
                                CornerRadius="4">
                            <!-- ContentPresenter：把按钮的 Content（这里是文字）摆到正中央 -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 触发器：满足某个条件时改变样式。下面做"悬停/按下"的反馈 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">   <!-- 鼠标悬停：背景提亮一档 -->
                                <Setter TargetName="bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">     <!-- 鼠标按下：再亮一档 -->
                                <Setter TargetName="bd" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 小知识：TemplateBinding 让模板内部元素的属性"跟随"按钮自己的属性。
                 比如代码里给按钮赋 Background = 蓝色，这个 Border 的背景就会跟着变蓝 -->
        </Style>

        <!-- ─────────────── 左侧导航按钮：在 BtnDark 基础上定制尺寸 ───────────────
             BasedOn = "继承"另一个样式，先拿它的全部设置，再补/改自己的 -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource BtnDark}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>    <!-- 顺序：上,右,下,左 → 按钮之间留 10px 空隙 -->
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- ─────────────── 搜索按钮：矮一点、固定宽度 ─────────────── -->
        <Style x:Key="SearchBtn" TargetType="Button" BasedOn="{StaticResource BtnDark}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="72"/>
        </Style>

        <!-- ─────────────── TextBox 输入框的全局样式（隐式样式） ───────────────
             没有写 x:Key 的样式 = 隐式样式：全程序所有 TextBox 会自动套用，不用逐个指定。
             黑底白字的程序里，输入框也得是深色的，否则蹦个白框很扎眼。 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>    <!-- 输入框底色：近黑 -->
            <Setter Property="Foreground" Value="White"/>       <!-- 打进去的字：白色 -->
            <Setter Property="CaretBrush" Value="White"/>       <!-- 光标：白色（默认黑光标在深底上看不见） -->
            <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,8,0"/>        <!-- 文字左右各留 8px，不贴边 -->
            <Setter Property="SelectionBrush" Value="#FF2F66E0"/> <!-- 按住拖动选中文字时的高亮色 -->
        </Style>

    </Application.Resources>
</Application>
