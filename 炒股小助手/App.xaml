<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     App.xaml —— 程序入口 + 全局共享资源

     1. 这里【没有】StartupUri：主窗口不是在这里自动打开的，
        而是由 App.xaml.cs 的 MainFlow（启动总流程）里 new MainWindow() 创建，
        为的是让"打开窗口 → 缓存检查 → 亮主界面 → 启动心跳"这四步写在同一个方法里。
        （如果这里再写 StartupUri，程序会开出两个窗口。）
     2. <Application.Resources>：全局样式放这里，每个页面都能直接用
        （用 {StaticResource xxx} 找样式时，自己身上找不到会逐级往上找，最后由这层兜底）
     ═══════════════════════════════════════════════════════════════════════════ -->
<Application x:Class="炒股小助手.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ─────────────── 深色按钮的通用外观（其它按钮样式都从它继承） ───────────────
             系统默认按钮是浅色系，直接放黑底上很刺眼，所以自己画一个模板：
             按钮 = 一个圆角边框 + 居中的文字                                   -->
        <Style x:Key="BtnDark" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>            <!-- 文字：白色 -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>                 <!-- 鼠标移上去变成小手 -->
            <Setter Property="Background" Value="#FF262626"/>        <!-- 常态背景：深灰 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FF3A3A3A"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 触发器：悬停 / 按下时把背景逐级提亮，给出操作反馈 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">   <!-- 悬停 -->
                                <Setter TargetName="bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">     <!-- 按下 -->
                                <Setter TargetName="bd" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- TemplateBinding：模板内部元素跟随按钮自身的属性。
                 代码里给按钮赋 Background = 蓝色，这个 Border 就跟着变蓝 -->
        </Style>

        <!-- ─────────────── 左侧导航按钮：在 BtnDark 基础上定制尺寸 ───────────────
             BasedOn = 继承 BtnDark，先拿到它的全部设置，再补自己的 -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource BtnDark}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>    <!-- Margin 顺序是 上,右,下,左：按钮之间留 10px -->
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- ─────────────── 搜索按钮：矮一点、固定宽度 ─────────────── -->
        <Style x:Key="SearchBtn" TargetType="Button" BasedOn="{StaticResource BtnDark}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="72"/>
        </Style>

        <!-- ─────────────── TextBox 的全局样式（隐式样式） ───────────────
             没写 x:Key = 隐式样式：全程序的 TextBox 自动套用，不用逐个指定。
             黑底程序里输入框也得是深色，否则蹦出一个白框很扎眼。 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>    <!-- 输入框底色：近黑 -->
            <Setter Property="Foreground" Value="White"/>       <!-- 打进去的字：白色 -->
            <Setter Property="CaretBrush" Value="White"/>       <!-- 光标：白色（默认黑光标在深底上看不见） -->
            <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,8,0"/>        <!-- 文字左右各留 8px，不贴边 -->
            <Setter Property="SelectionBrush" Value="#FF2F66E0"/> <!-- 按住拖动选中文字时的高亮色 -->
        </Style>

    </Application.Resources>
</Application>
