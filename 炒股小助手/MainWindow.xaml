<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     MainWindow.xaml —— 主窗口（整个程序的"外壳"）

     窗口里叠放了两层内容（Grid 里后写的盖在先写的上面）：
       第一层 MainUi（主界面）＝ 左侧 150px 导航栏（6 个按钮）+ 右侧页面区。
                               初始 Visibility="Collapsed"（藏起来，启动时看不见）
       第二层 LoadingLayer（加载层）＝ 全黑背景，正中央显示"正在加载中"。
                               初始可见 → 程序一打开看到的就是它

     启动流程（代码在 MainWindow.xaml.cs）：
       Window_Loaded → Loading() 确认加载层显示
                     → MainCache() 缓存检查（桌面 UserCache.json）
                     → 输出 true 才 UIMake()：收掉加载层、亮出 MainUi
     ═══════════════════════════════════════════════════════════════════════════ -->

<!-- ⚠ 补充说明：XAML 里给"开始标签内部"写注释是不合法的（会把解析器搞晕），
     所以下面所有开始标签的属性区一律不写注释，说明全部放在标签外面 -->

<Window x:Class="炒股小助手.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="股票小助手.v1"
        Height="620" Width="960" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        FontSize="14"
        Background="#FF111111"
        Foreground="White"
        Loaded="Window_Loaded">
    <!-- 窗口级设置说明：
         Background = 窗口底色（黑 #111111，程序整体黑底）
         Foreground = 前景色默认值（白）：TextBlock 等控件会"继承"这个颜色
         FontFamily = 全局字体用微软雅黑，中文显示更整齐
         Loaded     = 窗口显示完成后触发 → 去代码里跑启动流程 -->

    <!-- ═══════════════════════════════════════════════════════════════════════
         【v0.1 旧版界面，已停用，注释留档】
         内容：顶部股票代码输入框 + 注入按钮 + 底部一张只读盘口文字表
         新版改成"启动流程 + 多页面"后，这块布局作废，行情功能以后在
         v1 的页面里重做，所以整段包进 XML 注释里不参与运行
         ═══════════════════════════════════════════════════════════════════════
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBox x:Name="getstocknumber" Width="180" Height="30" FontSize="16"
                     VerticalContentAlignment="Center" Text="sz159248"/>
            <Button x:Name="Input" Content="注入代码" Width="100" Height="30"
                    Margin="10,0,0,0" Click="Input_Click"/>
        </StackPanel>

        <TextBlock x:Name="QuoteBoard" Grid.Row="1" Margin="0,16,0,0"
                   FontFamily="Consolas" FontSize="14" LineHeight="24"
                   Text="等待数据..." TextWrapping="NoWrap"/>
    </Grid>
    -->
    <!-- ══════════════════ 以上为 v0.1 旧界面 ══════════════════ -->

    <!-- 窗口的"内容总容器"：里面叠两层 -->
    <Grid>

        <!-- ═══════════════ 第一层：主界面（初始隐藏） ═══════════════ -->
        <!-- Visibility="Collapsed"：不占空间也不显示，等 UIMake() 里把它改回 Visible -->
        <Grid x:Name="MainUi" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- 列宽写法：150 = 固定 150 像素；* = "吃掉剩下的全部空间"。
                     窗口被拉伸时 150 不动、右列跟着变宽 -->
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左列：导航栏 ── -->
            <!-- Border = 自带边框/背景的容器。这里只画右侧 1px 深灰竖线，把两区分开 -->
            <Border Grid.Column="0" Background="#FF1C1C1C"
                    BorderBrush="#FF333333" BorderThickness="0,0,1,0">
                <!-- NavPanel：6 个导航按钮都装在这里。
                     给面板取名字，是因为切页代码要遍历它的子控件做"互斥高亮" -->
                <StackPanel x:Name="NavPanel" Margin="12,16,12,0">
                    <Button x:Name="MainBtn"      Content="主界面"   Style="{StaticResource NavBtn}" Click="MainBtn_Click"/>
                    <Button x:Name="WatchlistBtn" Content="自选股"   Style="{StaticResource NavBtn}" Click="WatchlistBtn_Click"/>
                    <Button x:Name="HistoryBtn"   Content="历史搜索" Style="{StaticResource NavBtn}" Click="HistoryBtn_Click"/>
                    <Button x:Name="StatsBtn"     Content="当日统计" Style="{StaticResource NavBtn}" Click="StatsBtn_Click"/>
                    <Button x:Name="GuideBtn"     Content="操作教程" Style="{StaticResource NavBtn}" Click="GuideBtn_Click"/>
                    <Button x:Name="SettingsBtn"  Content="设置"     Style="{StaticResource NavBtn}" Click="SettingsBtn_Click"/>
                    <!-- 每个按钮做了两件事：
                         ① Style 引用 App.xaml 里的 NavBtn（深色圆角外观）
                         ② Click 挂上事件 → 点按钮就在代码里切页面 -->
                </StackPanel>
            </Border>

            <!-- ── 右列：页面区 ── -->
            <!-- ContentControl：一次只能"装一个孩子"的容器。
                 换页面 = 换它的 Content（代码里写 PageHost.Content = 某个页面） -->
            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>

        <!-- ═══════════════ 第二层：加载层（默认盖在最上面） ═══════════════ -->
        <!-- 背景纯黑 + 正中央一行"正在加载中"（白字）。
             因为是后声明的，所以它盖在 MainUi 之上 —— 启动时用户只看到它 -->
        <Grid x:Name="LoadingLayer" Background="#FF111111">
            <TextBlock Text="正在加载中"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
